{
  "name": "Prediction",
  "type": "object",
  "properties": {
    "playerId": {
      "type": "string"
    },
    "matchId": {
      "type": "string"
    },
    "homeScore": {
      "type": "number"
    },
    "awayScore": {
      "type": "number"
    },
    "penaltyPick": {
      "type": "string",
      "enum": [
        "h",
        "a"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "final"
      ],
      "default": "draft"
    }
  },
  "required": [
    "playerId",
    "matchId"
  ]
}